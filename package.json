{
  "name": "flight-demo",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve shell",
    "build": "ng build shell",
    "watch": "ng build shell --watch --configuration development",
    "test": "ng test shell --watch=false",
    "test:booking": "ng test booking --watch=false",
    "lint": "eslint apps libs tools",
    "start:ai": "node --env-file=app.env --env-file-if-exists=.env node_modules/mastra/dist/index.js dev --dir apps/ai-server/src/mastra",
    "start:mcp": "node --env-file=app.env --env-file-if-exists=.env --import tsx apps/mcp-server/src/server.ts",
    "prestart:mcp": "npm run build:mcp",
    "start:aui": "node tools/start-aui.mjs",
    "build:ai": "node --env-file=app.env --env-file-if-exists=.env node_modules/mastra/dist/index.js build --dir apps/ai-server/src/mastra",
    "build:mcp": "vite build --config apps/mcp-server/vite.config.mts",
    "check:ai": "tsc -p apps/ai-server/tsconfig.json && tsc -p apps/mcp-server/tsconfig.json",
    "check:openai": "node --use-env-proxy --env-file=app.env --env-file-if-exists=.env tools/check-openai.mjs",
    "test:ai": "node --import tsx --test apps/ai-server/test/*.test.ts apps/mcp-server/test/*.test.ts",
    "setup:angular-ai": "node tools/angular-ai/setup.mjs",
    "mcp:angular": "node tools/angular-ai/mcp.mjs",
    "check:angular-ai": "node tools/angular-ai/verify.mjs",
    "test:angular-ai": "node --test tools/angular-ai/session.test.mjs",
    "ag-ui-simple:client": "node --import tsx demos/ag-ui-simple/index.ts",
    "ag-ui-simple:client-tools": "node --import tsx demos/ag-ui-simple/with-tools.ts",
    "ai-demo-server": "node --use-env-proxy --env-file=app.env --env-file-if-exists=.env tools/start-ai-demo.mjs",
    "ai-demo-client": "node --watch --import tsx demos/ai-demo/client/index.ts",
    "ai-demo-client:details": "node --watch --import tsx demos/ai-demo/client/index.ts --details",
    "mcp-apps-demo": "vite --config demos/mcp-apps-demo/vite.config.ts --open /host.html",
    "mcp-apps-demo:build": "vite build --config demos/mcp-apps-demo/vite.config.ts",
    "voice-demo": "vite demos/voice-demo",
    "ai-server": "npm run start:ai",
    "ai-server:build": "npm run build:ai",
    "ai-server:start": "node --env-file=app.env --env-file-if-exists=.env node_modules/mastra/dist/index.js start --dir apps/ai-server/src/mastra",
    "agent": "npm run ai-server",
    "agent:build": "npm run ai-server:build",
    "agent:start": "npm run ai-server:start",
    "mcp-server": "concurrently --kill-others \"npm run mcp-server:app:watch\" \"node --env-file=app.env --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch apps/mcp-server/src/server.ts\"",
    "mcp-server:app:build": "npm run build:mcp",
    "mcp-server:app:watch": "vite build --config apps/mcp-server/vite.config.mts --watch",
    "mcp-server:start": "npm run start:mcp",
    "simple-client": "ng serve simple-client",
    "a2ui-demo": "ng serve a2ui-demo",
    "a2ui-demo:build": "ng build a2ui-demo"
  },
  "private": true,
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.4",
    "@angular/language-service": "~22.2.4",
    "@eslint/js": "^10.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@schematics/angular": "~22.2.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "angular-eslint": "^22.6.0",
    "concurrently": "10.0.6",
    "eslint": "^10.14.0",
    "https-proxy-agent": "9.1.0",
    "jsdom": "^30.1.3",
    "mastra": "1.37.0",
    "ng-packagr": "^22.2.5",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@a2ui/web_core": "0.14.0",
    "@ag-ui/a2ui-middleware": "0.0.14",
    "@ag-ui/a2ui-toolkit": "0.0.5",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/mastra": "2.0.2",
    "@ag-ui/mcp-apps-middleware": "0.1.3",
    "@ai-sdk/openai": "4.0.106",
    "@angular-architects/paper-design": "^2.0.1",
    "@angular/cdk": "~22.2.5",
    "@angular/common": "~22.2.4",
    "@angular/compiler": "~22.2.4",
    "@angular/core": "~22.2.4",
    "@angular/forms": "~22.2.4",
    "@angular/platform-browser": "~22.2.4",
    "@angular/router": "~22.2.4",
    "@copilotkit/angular": "0.6.0",
    "@mastra/client-js": "1.58.0",
    "@mastra/core": "1.81.0",
    "@mastra/libsql": "1.28.0",
    "@mastra/loggers": "1.3.10",
    "@mastra/memory": "1.40.0",
    "@mastra/observability": "1.23.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "chart.js": "4.6.1",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "express": "5.3.0",
    "hono": "4.13.16",
    "jsonata": "2.2.2",
    "marked-katex-extension": "5.1.13",
    "ngx-markdown": "22.1.1",
    "quickjs-emscripten": "0.32.0",
    "rxjs": "7.8.1",
    "tslib": "^2.9.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.9.0"
}
